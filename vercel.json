{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "functions": { "api/sync.ts": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/sync", "schedule": "0 10 * * *" }]
}
