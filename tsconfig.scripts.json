{
  // Typechecks the tsx-run CLIs under scripts/ (AI-648) and their tests
  // (AI-662). tsx strips types without checking them, so this config is the
  // only signal that a change in src/** broke a script. module stays nodenext
  // (from tsconfig.api.json): scripts import src/** with .js extensions.
  "extends": "./tsconfig.api.json",
  "include": ["scripts/**/*.ts", "src/vite-env.d.ts"]
}
